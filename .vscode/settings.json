{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "editor.formatOnSave": true, // 保存時に自動整形
  "editor.defaultFormatter": "esbenp.prettier-vscode", // デフォルトの整形器をPrettierに
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit" // 保存時にESLintで修正可能な箇所を自動修正
  },
  "css.lint.unknownAtRules": "ignore", // Tailwind CSS v4のカスタムat-rule (@variant, @theme) の警告を無視
  "files.exclude": {
    "firebase-functions/node_modules": true,
    "firebase-functions/lib": true
  },
  "search.exclude": {
    "firebase-functions/node_modules": true,
    "firebase-functions/lib": true
  },
  "files.watcherExclude": {
    "firebase-functions/node_modules/**": true,
    "firebase-functions/lib/**": true
  },
  "workbench.colorCustomizations": {
    "activityBar.background": "#3E253D",
    "titleBar.activeBackground": "#573356",
    "titleBar.activeForeground": "#FCF9FC",
    "titleBar.inactiveBackground": "#3E253D",
    "titleBar.inactiveForeground": "#FCF9FC",
    "statusBar.background": "#3E253D",
    "statusBar.foreground": "#FCF9FC",
    "statusBar.debuggingBackground": "#3E253D",
    "statusBar.debuggingForeground": "#FCF9FC",
    "statusBar.noFolderBackground": "#3E253D",
    "statusBar.noFolderForeground": "#FCF9FC"
  }
}

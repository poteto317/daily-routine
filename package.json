{
  "name": "daily-routine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next', {recursive: true, force: true})\"",
    "generate:fcm-sw": "node tools/generate-firebase-messaging-sw.mjs",
    "dev": "npm run generate:fcm-sw && next dev --webpack",
    "build": "npm run generate:fcm-sw && next build --webpack",
    "start": "npm run generate:fcm-sw && next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0",
    "tailwind:scan": "node tools/tailwind/check-shorthand.mjs",
    "tailwind:fix": "node tools/tailwind/check-shorthand.mjs --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "cross-env TZ=Asia/Tokyo jest --forceExit",
    "test:watch": "cross-env TZ=Asia/Tokyo jest --watch",
    "test:ci": "cross-env TZ=Asia/Tokyo jest --ci --coverage --forceExit",
    "verify:fast": "npm run tailwind:scan && npm run lint && npm run typecheck && npm test -- --runInBand",
    "verify": "npm run verify:fast && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "chart.js": "^4.5.1",
    "firebase": "^12.8.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "terser-webpack-plugin": "^5.3.16",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "workbox-webpack-plugin": "^7.4.0"
  }
}

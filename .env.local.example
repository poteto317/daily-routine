# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project credentials

# Optional local development fallback auth
# Set to "true" to enable local auth on localhost without Firebase.
# This setting is ONLY effective when Firebase is NOT configured
# (i.e. apiKey / projectId / appId are all unset — isFirebaseConfigured is false).
# If Firebase is configured, this flag is ignored and Firebase auth is used instead.
# In local mode, the following auth methods are available:
#   - Anonymous login
#   - Test account login
#   - Email/password sign-in and sign-up (email is stored in localStorage; password is NOT verified or saved)
# Protected by a runtime hostname check (localhost / 127.0.0.1 / ::1 only),
# so enabling this in a production build will NOT allow bypass from the public internet.
# Keep "false" here as a safe default; set to "true" in your own .env.local when needed.
NEXT_PUBLIC_ENABLE_LOCAL_AUTH=false

# Firebase API Key
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key

# Firebase Auth Domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id

# Firebase App ID
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase VAPID Key (for push notifications)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# Firebase Functions URL (optional, for sync functionality)
NEXT_PUBLIC_FUNCTIONS_URL=https://your-region-your-project-id.cloudfunctions.net

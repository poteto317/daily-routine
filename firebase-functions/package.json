{
  "name": "functions",
  "scripts": {
    "lint": "echo 'Skipping lint for now'",
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.5",
    "@grpc/grpc-js": "^1.14.7",
    "browserslist": "^4.29.5",
    "fast-xml-parser": "^5.12.1",
    "flatted": "^3.4.4",
    "lodash": "^4.18.1",
    "protobufjs": "^7.5.4",
    "firebase-functions-test": {
      "ts-deepmerge": "^8.0.0"
    }
  },
  "private": true
}
